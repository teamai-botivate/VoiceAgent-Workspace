# Application
NODE_ENV=development
HOST=0.0.0.0
PORT=3100
PUBLIC_BASE_URL=https://your-reserved-tunnel.example
LOG_LEVEL=info
INTERNAL_API_TOKEN=replace-with-a-long-random-token
AGENT_TOOL_SECRET=replace-with-a-different-long-random-token
LLM_GATEWAY_TOKEN=replace-with-a-third-long-random-token
ALLOWED_TEST_PHONE_NUMBERS=+910000000000
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_MS=15000

# Turso
TURSO_DATABASE_URL=libsql://database-organization.turso.io
TURSO_AUTH_TOKEN=replace-with-turso-token
# Existing environments using TURSO_DATABASE_TOKEN are supported as a compatibility alias.

# ElevenLabs
ELEVENLABS_API_KEY=replace-with-elevenlabs-api-key
ELEVENLABS_AGENT_ID=replace-with-agent-id
ELEVENLABS_PHONE_NUMBER_ID=replace-with-agent-phone-number-id
ELEVENLABS_PRONUNCIATION_DICTIONARY_ID=replace-with-dictionary-id
ELEVENLABS_PRONUNCIATION_DICTIONARY_VERSION_ID=replace-with-dictionary-version-id
ELEVENLABS_WEBHOOK_SECRET=replace-with-elevenlabs-webhook-signing-secret
ELEVENLABS_RECORD_CALLS=false

# Groq (kept by this service; not sent to ElevenLabs)
GROQ_API_KEY=replace-with-groq-api-key
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low

# Twilio Auth Token is used only to validate direct Twilio callbacks.
TWILIO_ACCOUNT_SID=replace-with-twilio-account-sid
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
TWILIO_PHONE_NUMBER=+15551234567
TWILIO_TRIAL_MODE=true
